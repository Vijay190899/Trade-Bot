# Copy to .env and fill in. NEVER commit .env
# Freqtrade REST API (only needed if api_server.enabled = true)
FREQTRADE_API_USER=changeme
FREQTRADE_API_PASSWORD=changeme
FREQTRADE_JWT_SECRET=generate_a_random_64_char_string

# Exchange keys — leave EMPTY for dry-run / paper trading.
# Only required for live trading, which this project does not perform.
BINANCE_API_KEY=
BINANCE_API_SECRET=
