{
    "freqaimodel": "AntigravityRLModel",
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 8,
        "expiration_hours": 24,
        "continual_learning": true,
        "identifier": "continual_test_on",
        "feature_parameters": {
            "include_timeframes": ["1h", "4h"],
            "include_corr_pairlist": ["BTC/USDT"],
            "label_period_candles": 24,
            "include_shifted_candles": 2,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [10, 20, 40]
        },
        "data_split_parameters": {
            "test_size": 0.15,
            "shuffle": false
        },
        "rl_config": {
            "train_cycles": 25,
            "add_state_info": false,
            "max_trade_duration_candles": 300,
            "max_training_drawdown_pct": 0.02,
            "cpu_count": 4,
            "model_type": "PPO",
            "policy_type": "MlpPolicy",
            "device": "cuda",
            "model_reward_parameters": {
                "rr":                  1,
                "profit_aim":          0.025,
                "regime_win_rates":    {},
                "recent_loss_rate":    0.0
            }
        }
    }
}
