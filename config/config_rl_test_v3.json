{
    "freqaimodel": "AntigravityRLModelV3",
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 90,
        "backtest_period_days": 7,
        "live_retrain_hours": 8,
        "expiration_hours": 48,
        "continual_learning": false,
        "identifier": "v3_test",
        "feature_parameters": {
            "include_timeframes": [
                "1h",
                "4h"
            ],
            "include_corr_pairlist": [],
            "label_period_candles": 24,
            "include_shifted_candles": 1,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [
                10,
                20,
                40
            ]
        },
        "data_split_parameters": {
            "test_size": 0.15,
            "shuffle": false
        },
        "model_training_parameters": {
            "learning_rate": 0.0003,
            "n_steps": 2048,
            "batch_size": 256,
            "n_epochs": 10,
            "gamma": 0.99,
            "gae_lambda": 0.95,
            "clip_range": 0.2,
            "ent_coef": 0.01,
            "vf_coef": 0.5,
            "max_grad_norm": 0.5,
            "verbose": 0
        },
        "rl_config": {
            "train_cycles": 40,
            "add_state_info": false,
            "max_trade_duration_candles": 300,
            "max_training_drawdown_pct": 0.05,
            "randomize_starting_position": true,
            "cpu_count": 4,
            "model_type": "MaskablePPO",
            "policy_type": "MlpPolicy",
            "device": "cuda",
            "model_reward_parameters": {
                "rr": 1,
                "profit_aim": 0.05,
                "regime_win_rates": {},
                "recent_loss_rate": 0.0,
                "idle_penalty": 0.0005
            }
        }
    }
}